{
    "name": "whatsapp-sizzlingchilli-gateway",
    "version": "2.0.0",
    "description": "WhatsApp Gateway for ChillAjar using Baileys (no Puppeteer)",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "docker:up": "docker compose -f docker/docker-compose.yml up -d",
        "docker:up:local": "docker compose -f docker/docker-compose.local.yml up -d",
        "docker:down": "docker compose -f docker/docker-compose.yml down",
        "docker:build": "docker compose -f docker/docker-compose.yml build --no-cache",
        "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ekomh170/whatsapp-sizzlingchilli-gateway-chillajar.git"
    },
    "keywords": [
        "whatsapp",
        "baileys",
        "api",
        "gateway",
        "chillajar"
    ],
    "author": "ChillAjar Team",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/ekomh170/whatsapp-sizzlingchilli-gateway-chillajar/issues"
    },
    "homepage": "https://github.com/ekomh170/whatsapp-sizzlingchilli-gateway-chillajar",
    "dependencies": {
        "@whiskeysockets/baileys": "^6.7.21",
        "body-parser": "^1.20.2",
        "dotenv": "^16.0.0",
        "express": "^4.18.2",
        "node-telegram-bot-api": "^0.66.0",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "winston": "^3.11.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
